DATABASE_URL=postgresql://marketpulse:REPLACE@127.0.0.1:5434/marketpulse_dev
TEST_DATABASE_URL=postgresql://marketpulse:REPLACE@127.0.0.1:5434/marketpulse_test
DEMO_DATABASE_URL=postgresql://marketpulse:REPLACE@127.0.0.1:5434/marketpulse_demo
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
APP_ENV=development
# disabled: truthful recoverable unavailable errors; fixture: explicitly opt into a demo business
TRANSCRIPTION_MODE=disabled
